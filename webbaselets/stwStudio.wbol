				<content uuid="c7StudioConnectorList01" origin="a6T6S55WbZjerGVamxGi8kA" type="table">
					<name>
						<text xml:lang="en" slug="connector-list"><![CDATA[Connector list]]></text>
					</name>
					<query connector="wbol" parameters="/connectors"><![CDATA[(
						$escape := function($value) {
							$replace($replace($replace($string($value), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
						};
						$map($, function($item) {
							{"displayName": $escape($item.name), "displayType": $escape($item.type),
							 "displayHost": $escape($item.host ? $item.host : "-"), "id": $item.id}
						})
					)]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('nodata="No connectors configured" rows="1000"')
l('')a('/stws/edit/connector')p('connector;@@id')t('<i class="fa-light fa-pen-to-square"></i>')
l('Name')f
l('Type')f
l('Host')f
]]></text>
