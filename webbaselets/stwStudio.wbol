							<text xml:lang="en"><![CDATA[Webbase <span style="float:right"><i class="fa-kit fa-light-folder-circle-plus" aria-label="New area"></i> <i class="fa-kit fa-light-file-circle-plus" aria-label="New page"></i> <i class="fa-kit fa-light-rectangle-circle-plus" aria-label="New content"></i></span>]]></text>
						</option>
