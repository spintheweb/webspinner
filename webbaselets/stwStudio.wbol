e(';search;')\a('placeholder="Search" aria-label="Search" data-stw-language="@@stwlanguage" onkeydown="_stwStudioSearchKey(event,this)"')
b(';stwnone')\a('type="button" data-stw-search-action="case" aria-pressed="false" title="Match case" aria-label="Match case" onclick="_stwStudioSearchToggle(this)"')t('<i class="fa-light fa-font" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-stw-search-action="word" aria-pressed="false" title="Match whole word" aria-label="Match whole word" onclick="_stwStudioSearchToggle(this)"')t('<i class="fa-light fa-text-width" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-stw-search-action="regex" aria-pressed="false" title="Use regular expression" aria-label="Use regular expression" onclick="_stwStudioSearchToggle(this)"')t('<i class="fa-light fa-asterisk" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-stw-search-action="search" title="Search" aria-label="Search" onclick="_stwStudioSearch(this)"')t('<i class="fa-light fa-magnifying-glass" aria-hidden="true"></i>')
\ne(';replace;')\a('placeholder="Replace" aria-label="Replace"')
