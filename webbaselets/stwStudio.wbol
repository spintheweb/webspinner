			<query connector="wbol" parameters="/search-results?ids=@stwsearchids&amp;locale=@stwsearchlocale"><![CDATA[(
				$icons := {
					"Portal": "globe", "Area": "folder", "Page": "file-lines",
					"Accordion": "bars-staggered", "Breadcrumbs": "chevrons-right",
					"Calendar": "calendar-days", "Chart": "chart-column",
					"Api": "server", "ClientScript": "code", "Script": "code",
					"Form": "rectangle-list",
					"Geomap": "map-location-dot", "Graph": "diagram-project",
					"Imagemap": "image", "Languages": "language", "List": "list",
					"Menus": "bars", "Pivot": "table-cells", "Shortcut": "arrow-up-right-from-square",
					"Table": "table", "Tabs": "window-restore", "Text": "align-left",
					"Tree": "sitemap"
				};
				$.(
					$icon := $lookup($icons, type = "Content" ? subtype : type);
					{
						"icon": "<i class='fa-light fa-fw fa-" & ($icon ? $icon : "rectangle") & "' aria-hidden='true'></i> ",
						"url": "/stws/edit/edit-" & (type in ["Portal", "Area", "Page"] ? $lowercase(type) : "content"),
						"uuid": uuid,
						"name": $replace($replace($replace(name, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
					}
				)
			)]]></query>
			<layout>
				<text xml:lang="en"><![CDATA[
\s('rows="@@stwrows" nodata="Nothing found" header="@@stwrows results"')
fapf\a('data-stw-editor onclick="event.preventDefault();_stwSendEditorRequest('@@url','@@uuid' )"')]]></text>
