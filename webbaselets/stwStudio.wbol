<?xml version="1.0" encoding="UTF-8"?>
<webbaselet xmlns="https://spintheweb.org/schemas/wbol.xsd" uuid="a6T6S55WbZjerGVamxGi8kA"
	mainpage="c6TC0s1xSa5NgDIgMyCbIhL" langs="en">
	<name>
		<text xml:lang="en" slug="stws"><![CDATA[STW Studio]]></text>
	</name>
	<children>
		<page uuid="c6TC0s1xSa5NgDIgMyCbIhL" origin="a6T6S55WbZjerGVamxGi8kA">
			<name>
				<text xml:lang="en" slug="edit"><![CDATA[Edit]]></text>
			</name>
			<children>
				<content uuid="c6TC0s1xSa5NgDIgMyCdmzY" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
					section="stwShow">
					<name>
						<text xml:lang="en" slug="edit-site"><![CDATA[Edit Site]]></text>
					</name>
					<query datasource="stw"><![CDATA[["uuid", "name", "slug", "URL", "lang", "mainpage"]]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('caption='<i class="fa-light fa-globe"></i> @@name' key="uuid"')hl('Name')el('Slug')el('URL')el('Language')el('Homepage')e\rb(';stw;update')t('Save')]]></text>
					</layout>
				</content>
				<content uuid="c6TC0s1xSa5NgDIgMyCdmzY" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
					section="stwShow">
					<name>
						<text xml:lang="en" slug="edit-area"><![CDATA[Edit Area]]></text>
					</name>
					<query datasource="stw"><![CDATA[["uuid", "name", "slug", "mainpage"]]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('caption='<i class="fa-light fa-folder"></i> @@name' key="uuid"')hl('Name')el('Slug')el('Mainpage')e\rb(';stw;update')t('Save')]]></text>
					</layout>
				</content>
				<content uuid="c6TC0s1xSa5NgDIgMyCdmzY" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
					section="stwShow">
					<name>
						<text xml:lang="en" slug="edit-page"><![CDATA[Edit Page]]></text>
					</name>
					<query datasource="stw"><![CDATA[["uuid", "name", "slug", "template"]]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('caption='<i class="fa-light fa-page"></i> @@name' key="uuid"')hl('Name')el('Slug')el('Template')e\rb(';stw;update')t('Save')]]></text>
					</layout>
				</content>
				<content uuid="c6TC0s1xSa5NgDIgMyCdmzY" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
					section="stwShow">
					<name>
						<text xml:lang="en" slug="edit-content"><![CDATA[Edit content]]></text>
					</name>
					<query datasource="stw"><![CDATA[["uuid", "name", "slug", "subtype", "section", "sequence", "dsn", "command", "params", "layout"]]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('caption='<i class="fa-light fa-rectangle"></i> @@name' key="uuid"')hl('Name')e\rl('Slug')e\rl('Type')\rD(';;1;Text;Table;Tree;List;Form;Calendar;Graph;Map;Plot')\rl('Section')el('Sequence')e\rl('DSN')e\rl('Command')m\rl('Parameters')e\rl('Layout')m\rb(';stw;update')t('Save')]]></text>
					</layout>
				</content>
				<content uuid="c6SyclmGzAM2uOpnred9ceG" origin="a6T6S55WbZjerGVamxGi8kA" type="table"
					class="stwFormCompact">
					<name>
						<text xml:lang="en" slug="edit-datasource"><![CDATA[Edit datasource]]></text>
					</name>
					<query datasource="stw"><![CDATA[["name", "type", "host", "port", "user", "password", "database", "contentType"]]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('key="name"')l('Name')el('Type')d(';;2;mysql;mySQL;api;API')l('Host')el('Port')e\a('type="number"')l('User')el('Password')wl('Database')el('Content-Type')d(';;1;application/json')b(';stw;update')t('Save')]]></text>
					</layout>
				</content>
				<content uuid="c6SyclmGzAM2uOK0hCP7VyK" origin="a6T6S55WbZjerGVamxGi8kA" type="table">
					<name>
						<text xml:lang="en" slug="role-visibility"><![CDATA[Role Visibility]]></text>
					</name>
					<query datasource="stw"><![CDATA[$keys(visibility)\@$v.{"name": $v,"value": $lookup(visibility, $v)}]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('key="name"')l('Name')fl('Visible')d(';;2;1;True;0;False')b(';stw;update')t('Save')]]></text>
					</layout>
				</content>
			</children>
		</page>
		<content uuid="c6TC0s1xSa7g1ciRv64FQ22" origin="a6T6S55WbZjerGVamxGi8kA" type="accordion">
			<name>
				<text xml:lang="en" slug="structure"><![CDATA[Structure]]></text>
			</name>
			<layout>
				<text xml:lang="en"><![CDATA[\s('header="&emsp;WEBBASE"')]]></text>
			</layout>
			<options>
				<option target="c6TC0s1xSa5NgDIgMyCbIhL">
					<text xml:lang="en"><![CDATA[Structure <span style="float:right"><i class="fa-kit fa-light-folder-circle-plus" aria-label="New area"></i> <i class="fa-kit fa-light-file-circle-plus" aria-label="New page"></i> <i class="fa-kit fa-light-rectangle-circle-plus" aria-label="New content"></i></span>]]></text>
				</option>
				<option target="c6SyclmGzAM2uOpnred9ceG">
					<text xml:lang="en"><![CDATA[Data sources <span style="float:right"><i class="fa-thin fa-plus" aria-label="New data source"></i></span>]]></text>
				</option>
				<option target="c6SyclmGzAM2uOK0hCP7VyK">
					<text xml:lang="en"><![CDATA[Roles <span style="float:right"><i class="fa-thin fa-plus" aria-label="New role"></i></span>]]></text>
				</option>
			</options>
		</content>
		<content uuid="c64HscPpcM9pByUEWIVTocq" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
			section="stwShowModal" class="stwFormCompact">
			<name>
				<text xml:lang="en" slug="search"><![CDATA[Search]]></text>
			</name>
			<layout>
				<text xml:lang="en"><![CDATA[\s('header="&emsp;SEARCH"')e\a('placeholder="Search"')e\a('placeholder="Replace"')b(';stw;search')t('Search')\nt('search results')]]></text>
			</layout>
		</content>
		<content uuid="c6TC0s1xSa5SWiCO4UTvujX" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
			section="stwShowModal" class="stwFormCompact">
			<name>
				<text xml:lang="en" slug="settings"><![CDATA[Settings]]></text>
			</name>
			<layout>
				<text xml:lang="en"><![CDATA[l('Color')d('tint;;1;Blue;Green;Red;Yellow;Purple;Gray')\rb('stws;save')t('Save')]]></text>
			</layout>
		</content>
		<page uuid="p7w0adQ8hdI0CUWkSHoOhYj" origin="a6T6S55WbZjerGVamxGi8kA">
			<name>
				<text xml:lang="en" slug="interface"><![CDATA[Interface]]></text>
			</name>
			<children>
				<content uuid="c6TC0s1xSa5NgDIgMyCdmzX" origin="a6T6S55WbZjerGVamxGi8kA" type="tabs"
					section="stwSidebar" sequence="2">
					<name>
						<text xml:lang="en" slug="activities"><![CDATA[activities]]></text>
					</name>
					<layout>
						<text xml:lang="en"><![CDATA[\s('mode="vertical"')]]></text>
					</layout>
					<options>
						<option target="c6TC0s1xSa7g1ciRv64FQ22" parameters="id=3">
							<text xml:lang="en"><![CDATA[<i class="fa-light fa-2x fa-sitemap" aria-label="Webbase"></i>]]></text>
						</option>
						<option target="c64HscPpcM9pByUEWIVTocq">
							<text xml:lang="en"><![CDATA[<i class="fa-light fa-2x fa-search" aria-label="Search"></i>]]></text>
						</option>
						<option target="c6TC0s1xSa5SWiCO4QcQf7T">
							<text xml:lang="en"><![CDATA[<i class="fa-light fa-2x fa-copy" aria-label="Explorer"></i>]]></text>
						</option>
						<option target="c6TC0s1xSa5SWiCO4UTvujX">
							<text xml:lang="en"><![CDATA[<i class="fa-light fa-2x fa-gear" aria-label="Settings"></i>]]></text>
						</option>
					</options>
				</content>
				<content uuid="c6TC0s1xSa5NgDIgMyCbIhL" origin="a6T6S55WbZjerGVamxGi8kA" type="tree">
					<name>
						<text xml:lang="en" slug="webbase"><![CDATA[Webbase]]></text>
					</name>
					<query datasource="stw"><![CDATA[($tree:=function($node){{"icon":$node.type & ($node.section ? "" : "*"),"url":"/stws/edit/" & $lowercase($node.type),"uuid":$node.uuid,"name":$node.name.en,"children":$node.children?$map($node.children,$tree):[]}};$tree($))]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[n('2;Site*;<i class="fa-light fa-globe"></i>;Area*;<i class="fa-light fa-folder"></i>;Page*;<i class="fa-light fa-file"></i>;Content*;<i class="fa-light fa-cloud"></i>;;<i class="fa-light fa-rectangle"></i>')apf]]></text>
					</layout>
				</content>
				<content uuid="c6TC0s1xSa5SWiCO4QcQf7T" origin="a6T6S55WbZjerGVamxGi8kA" type="table">
					<name>
						<text xml:lang="en" slug="explorer"><![CDATA[Explorer]]></text>
					</name>
					<query datasource="bash"><![CDATA[ls -l ./public]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[]]></text>
					</layout>
				</content>
				<content uuid="c6TC0s1xSa5NgDIgMyCdmzZ" origin="a6T6S55WbZjerGVamxGi8kA" type="form" section="main">
					<name>
						<text xml:lang="en" slug="logon"><![CDATA[Logon]]></text>
					</name>
					<layout>
						<text xml:lang="en"><![CDATA[\s('caption="Logon"')l('Username')e(';usr')t(' ')l('Password')w('pwd')b(';Logon;;stw;logon;@@usr;@@pwd')]]></text>
					</layout>
					<visibility>
						<role id="guests" visibility="true"></role>
					</visibility>
				</content>
			</children>
		</page>
	</children>
</webbaselet>