					<layout>
						<text xml:lang="en"><![CDATA[\s('caption="Edit connector"')h('id;@@id')l('Name')e(';name;@@name')\rl('Host')e(';host;@@host')\rl('User')e(';user;@@user')\rl('Database')e(';database;@@database')\rl('Content type')e(';contentType;@@contentType')\rl('From')e(';from;@@from')\rb('.;stwupdate;wbol;/connectors/@@id')t('Save')b('.;stwdelete;wbol;/connectors/@@id')t('Delete')]]></text>
