				<content uuid="c7StudioOptionsEdit0001" origin="a6T6S55WbZjerGVamxGi8kA" type="table">
					<name>
						<text xml:lang="en" slug="edit-options"><![CDATA[Options]]></text>
					</name>
					<query connector="wbol" parameters="/@uuid"><![CDATA[$merge([$,
						{"supported": $exists(options) ? "true" : "false",
						 "readonly": readonly = "true" or (blocked and blocked != $stwlogin) ? "true" : "false",
						 "message": $exists(options) ? "Edit options, then save changes." : "This content does not support options."}])]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('header="@@message" rows="1"')
l('Ref')e(';reference;;Elements')\a('data-stw-uuid="@uuid" data-stw-language="@@stwlanguage" data-stw-supported="@@supported" data-stw-readonly="@@readonly" data-stw-type="@@type" placeholder="Element slug, URL or path" aria-label="Reference"')
l('Text')e(';text;')
l('Parameters')e(';parameters;')\a('placeholder="Query string"')
b(';stwnone')\a('type="button" data-option-action="add" title="Add" aria-label="Add"')t('<i class="fa-light fa-plus" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-option-action="child" title="Add child" aria-label="Add child"')t('<i class="fa-light fa-folder-plus" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-option-action="up" title="Move up" aria-label="Move up"')t('<i class="fa-light fa-arrow-up" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-option-action="down" title="Move down" aria-label="Move down"')t('<i class="fa-light fa-arrow-down" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-option-action="delete" title="Delete" aria-label="Delete"')t('<i class="fa-light fa-trash" aria-hidden="true"></i>')
b(';stwnone')\a('type="button" data-option-action="save" title="Save" aria-label="Save"')t('<i class="fa-light fa-floppy-disk" aria-hidden="true"></i>')
t('<script name="stwStudioOptions" onload="stwStudioOptionsInit(this)">
function stwStudioOptionsInit(script) {
	const article = script.closest("article");
	if (article.dataset.stwOptionsInitialized) return;
	article.dataset.stwOptionsInitialized = "true";
	const tbody = article.querySelector("tbody");
	const template = tbody.querySelector("tr");
	const details = template.querySelector("input[name=reference]").dataset;
	const uuid = details.stwUuid;
	const language = details.stwLanguage;
	const readonly = details.stwReadonly === "true";
	const menus = details.stwType === "Menus";
	template.querySelectorAll("script").forEach(node => node.remove());
	template.querySelectorAll("input,select").forEach(node => { node.hidden = true; });
	template.querySelectorAll("[data-option-action]").forEach(button => {
		button.hidden = button.dataset.optionAction !== "add" && button.dataset.optionAction !== "save";
		button.disabled = true;
	});
	if (details.stwSupported !== "true") return;
	const endpoint = "/wbol/" + encodeURIComponent(uuid) + "/options";
	const getJson = async url => {
		const response = await fetch(url);
		if (!response.ok) throw new Error(await response.text() || "Could not load options");
		return response.json();
	};
	Promise.all([getJson(endpoint), getJson("/wbol")]).then(([options, tree]) => {
		const references = [];
		const paths = new Map();
		const referenceValues = new Map();
		const changed = () => { article.querySelector("header").textContent = "Unsaved option changes."; };
		const visit = (node, parentPath) => {
			const slug = node.slug && (node.slug[language] || Object.values(node.slug)[0]);
			const path = parentPath !== null && slug ? parentPath + "/" + slug : null;
			if (node.uuid && slug) references.push({ uuid: node.uuid, slug, path });
			(node.children || []).forEach(child => visit(child, path));
		};
		(tree.children || []).forEach(node => visit(node, ""));
		const slugCounts = new Map();
		references.forEach(ref => { slugCounts.set(ref.slug, (slugCounts.get(ref.slug) || 0) + 1); });
		const labels = references.map(ref => {
			let label = slugCounts.get(ref.slug) > 1 ? ref.slug + " (" + (ref.path || ref.uuid) + ")" : ref.slug;
			if (referenceValues.has(label)) label += " [" + ref.uuid + "]";
			referenceValues.set(label, ref.uuid);
			paths.set(ref.uuid, label);
			if (ref.path) paths.set(ref.path, label);
			return label;
		});
		const controls = template.querySelectorAll("[data-option-action]");
		controls.forEach(button => { button.disabled = readonly; });
		const render = () => {
			tbody.querySelectorAll("tr[data-option-row]").forEach(row => row.remove());
			const draw = (items, depth) => {
				items.forEach((item, index) => {
					const row = template.cloneNode(true);
					row.dataset.optionRow = "true";
					row.querySelectorAll("script").forEach(node => node.remove());
					const reference = row.querySelector("input[name=reference]");
					const list = row.querySelector("datalist");
					const text = row.querySelector("input[name=text]");
					const parameters = row.querySelector("input[name=parameters]");
					reference.hidden = false;
					text.hidden = false;
					parameters.hidden = false;
					reference.disabled = readonly;
					text.disabled = readonly;
					parameters.disabled = readonly;
					list.id = "stwOptions" + crypto.randomUUID();
					reference.setAttribute("list", list.id);
					list.replaceChildren(...labels.map(label => new Option(label)));
					reference.value = paths.get(item.ref) || item.ref || "";
					reference.setCustomValidity(slugCounts.get(reference.value) > 1 ? "Choose a specific path for this slug." : "");
					reference.style.marginInlineStart = (depth * 1.5) + "rem";
					text.value = item.name[language] || "";
					parameters.value = item.parameters || "";
					reference.addEventListener("input", () => {
						reference.setCustomValidity(slugCounts.get(reference.value) > 1 ? "Choose a specific path for this slug." : "");
						item.ref = referenceValues.get(reference.value) ?? reference.value;
						changed();
					});
					text.addEventListener("input", () => { item.name[language] = text.value; changed(); });
					parameters.addEventListener("input", () => { item.parameters = parameters.value; changed(); });
					row.querySelectorAll("[data-option-action]").forEach(button => {
						const action = button.dataset.optionAction;
						button.hidden = action === "add" || action === "save" || action === "child" && !menus;
						button.disabled = readonly || action === "up" && index === 0 || action === "down" && index === items.length - 1;
						button.addEventListener("click", () => {
							if (action === "child") (item.options ||= []).push({ name: {}, ref: "", parameters: "", options: [] });
							else if (action === "delete") {
								if (item.options?.length && !window.confirm("Delete this option and its nested options?")) return;
								items.splice(index, 1);
							} else if (action === "up" || action === "down") {
								const destination = index + (action === "up" ? -1 : 1);
								[items[index], items[destination]] = [items[destination], items[index]];
							}
							changed();
							render();
						});
					});
					tbody.insertBefore(row, template);
					if (item.options?.length) draw(item.options, depth + 1);
				});
			};
			draw(options, 0);
		};
		template.querySelector("[data-option-action=add]").addEventListener("click", () => {
			options.push({ name: {}, ref: "", parameters: "", ...(menus ? { options: [] } : {}) });
			changed();
			render();
		});
		template.querySelector("[data-option-action=save]").addEventListener("click", async event => {
			const save = event.currentTarget;
			const invalid = [...article.querySelectorAll("input[name=reference]")].find(input => !input.hidden && !input.checkValidity());
			if (invalid) {
				invalid.reportValidity();
				return;
			}
			article.querySelectorAll("input,select,button").forEach(control => { control.disabled = true; });
			try {
				const response = await fetch(endpoint, {
					method: "PUT",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(options)
				});
				if (!response.ok) throw new Error(await response.text() || "Could not save options");
				article.querySelector("header").textContent = "Options saved.";
			} catch (error) {
				window.alert(error instanceof Error ? error.message : String(error));
			} finally {
				template.querySelector("[data-option-action=add]").disabled = readonly;
				save.disabled = readonly;
				render();
			}
		});
		render();
	}).catch(error => {
		window.alert(error instanceof Error ? error.message : String(error));
	});
}
</script>')]]></text>
					</layout>
				</content>
				<content uuid="c7StudioVisRoles0000001" origin="a6T6S55WbZjerGVamxGi8kA" type="table">
					<name>
						<text xml:lang="en" slug="visibility-roles"><![CDATA[Visibility]]></text>
					</name>
					<query connector="wbol" parameters="/roles/visibility"><![CDATA[$map($, function($role) {
						{"role": $role}
					})]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('rows="1000000" nodata="No roles found"')
l('Role')f
l('Visibility')c('visibility;;')\a('disabled data-stw-role="@@role" data-stw-uuid="@uuid" aria-label="Visibility for @@role"')
t('<script name="stwStudioVisibility" onload="stwStudioVisibilityInit(this)">
function stwStudioVisibilityInit(script) {
	const table = script.closest("article");
	if (table.dataset.stwVisibilityInitialized) return;
	table.dataset.stwVisibilityInitialized = "true";
	const boxes = table.querySelectorAll("input[data-stw-role]");
	const endpoint = "/wbol/" + encodeURIComponent(boxes[0].dataset.stwUuid) + "/visibility";
	const setState = (box, value) => {
		box.checked = value === true;
		box.indeterminate = value === null;
		box.tristate = value === null ? 3 : value ? 1 : 2;
	};
	fetch(endpoint).then(async response => {
		if (!response.ok) throw new Error(await response.text() || "Could not load visibility");
		return response.json();
	}).then(visibility => {
		boxes.forEach(box => {
			const role = box.dataset.stwRole;
			let value = Object.hasOwn(visibility, role) ? visibility[role] : null;
			setState(box, value);
			box.hidden = false;
			if (role === "root" || role === "administrator") return;
			box.disabled = false;
			box.addEventListener("click", async () => {
				const next = box.indeterminate ? null : box.checked;
				box.disabled = true;
				try {
					const response = await fetch(endpoint, {
						method: "PATCH",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ [role]: next })
					});
					if (!response.ok) throw new Error(await response.text() || "Could not save visibility");
					value = next;
				} catch (error) {
					setState(box, value);
					window.alert(error instanceof Error ? error.message : String(error));
				} finally {
					box.disabled = false;
				}
			});
		});
	}).catch(error => {
		window.alert(error instanceof Error ? error.message : String(error));
	});
}
</script>')]]></text>
					</layout>
				</content>
				<content uuid="c7StudioConnectorList01" origin="a6T6S55WbZjerGVamxGi8kA" type="table">
