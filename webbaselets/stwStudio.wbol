					<layout>
						<text xml:lang="en"><![CDATA[
\A('style="display:flex;flex:0 0 auto;align-items:center;justify-content:space-evenly;gap:0.5rem;"')
t('<i class="fa-light fa-fw fa-arrow-left"></i><i class="fa-light fa-fw fa-arrow-right"></i><i class="fa-light fa-rotate-right"></i><i class="fa-light fa-fw fa-house"></i>')
e(';url;@rul')\a('onchange="alert()" style="flex-grow:1;min-width:0;width:100%;box-sizing:border-box;margin:0;"')\n('style="display:flex;flex:1 1 0;min-height:0;"')
O('@url')
]]></text>
					</layout>
				</content>
				<content uuid="c7StudioMainTabs000001" origin="a6T6S55WbZjerGVamxGi8kA" type="tabs"
					section="main">
					<name>
						<text xml:lang="en" slug="main"><![CDATA[Main]]></text>
					</name>
					<layout>
						<text xml:lang="en"><![CDATA[]]></text>
					</layout>
					<options>
						<option ref="c6TC0s1xSa5NgDIgMyCdmzZ">
							<text xml:lang="en"><![CDATA[Portal]]></text>
						</option>
					</options>
				</content>
				<content uuid="c7StudioFileView000001" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
					class="stwForm stwStudioFileView">
					<name>
						<text xml:lang="en" slug="file-viewer"><![CDATA[File viewer]]></text>
					</name>
					<query connector="json"><![CDATA[{}]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('closable=true')
t('<section><p id="c7StudioFileStatus000001" role="status"></p><img id="c7StudioFileImage000001" alt="" hidden><div id="c7StudioFileText000001" hidden><label for="stwE0">File contents</label>')
m('javascript;contents;')
t('</div></section><script name="STWStudioFileViewer" onload="fnSTWStudioFileViewer()">
function fnSTWStudioFileViewer() {
	const selected = document.getElementById("c7StudioMainTabs000001")
		?.querySelector("dt.stwSelected[data-stw-file]");
	const status = document.getElementById("c7StudioFileStatus000001");
	const image = document.getElementById("c7StudioFileImage000001");
	const text = document.querySelector("#c7StudioFileText000001 textarea[name=contents]");
	if (!selected || !status || !image || !text) return;
	const url = "/" + selected.dataset.stwFile.split("/").map(encodeURIComponent).join("/");
	image.hidden = true;
	text.closest("#c7StudioFileText000001").hidden = true;
	status.textContent = "";
	if (selected.dataset.stwKind === "image") {
		image.src = url;
		image.hidden = false;
	} else if (selected.dataset.stwKind === "text") {
		text.value = "";
		text.closest("#c7StudioFileText000001").hidden = false;
		status.textContent = "Loading file…";
		fetch(url).then(response => {
			if (!response.ok) throw new Error(`Could not load file (${response.status})`);
			return response.text();
		}).then(contents => {
			text.value = contents;
			text.dispatchEvent(new Event("input", { bubbles: true }));
			status.textContent = "";
		}).catch(error => {
			status.textContent = error instanceof Error ? error.message : String(error);
			console.error("Could not load Studio file:", error);
		});
	} else {
		status.textContent = selected.dataset.stwKind === "pdf"
			? "PDF preview is not available yet."
			: "Preview is not available for this file type.";
	}
}
</script>')]]></text>
					</layout>
				</content>
			</children>
		</page>
	</children>
</webbaselet>