					<query connector="wbol" parameters="/connectors"><![CDATA[(
						$selected := "@connector";
						$filter($, function($item) { $item.id = $selected }).{
							"id": id, "name": name, "host": host ? host : "", "user": user ? user : "",
							"database": database ? database : "", "contentType": contentType ? contentType : "",
							"from": from ? from : ""
