				</content>
				<content uuid="c6TC0s1xSa5NgDIgMyCbIhL" origin="a6T6S55WbZjerGVamxGi8kA" type="tree">
					<name>
						<text xml:lang="en" slug="webbase"><![CDATA[Webbase]]></text>
					</name>
					<query connector="wbol" parameters="/"><![CDATA[(
					$icons := {
						"Portal": "globe", "Area": "folder", "Page": "file-lines",
						"Accordion": "bars-staggered", "Breadcrumbs": "chevrons-right",
						"Calendar": "calendar-days", "Chart": "chart-column",
						"Api": "server", "ClientScript": "code", "Script": "code",
						"Form": "rectangle-list",
						"Geomap": "map-location-dot", "Graph": "diagram-project",
						"Imagemap": "image", "Languages": "language", "List": "list",
						"Menus": "bars", "Pivot": "table-cells", "Shortcut": "arrow-up-right-from-square",
						"Table": "table", "Tabs": "window-restore", "Text": "align-left",
						"Tree": "sitemap"
					};
					$tree := function($node) {(
						$icon := $lookup($icons, $node.type = "Content" ? $node.subtype : $node.type);
						$lock := $node.blocked ? ($node.blocked = $stwlogin ?
							"<span data-stw-lock class='fa-light fa-fw fa-lock-open' aria-label='Locked by you'></span>" :
							"<span data-stw-lock class='fa-light fa-fw fa-lock' aria-label='Locked by another user'></span>") :
							"<span data-stw-lock hidden></span>";
						$section := $node.type = "Content" ? (
							$node.section = "" ? "<span class='fa-light fa-fw fa-rectangle' aria-label='No section'></span>" :
							$node.section = "modal" ? "<span class='fa-light fa-fw fa-window-maximize' aria-label='Modal'></span>" :
							$node.section = "modeless" ? "<span class='fa-light fa-fw fa-window-restore' aria-label='Modeless'></span>" : ""
						) : "";
						$visibility := $node.visibility = 0 ? "<span class='fa-light fa-fw fa-eye-slash' aria-label='Hidden'></span>" :
							$node.visibility = 1 ? "<span class='fa-light fa-fw fa-eye' aria-label='Visible'></span>" :
							$node.visibility = 2 ? "<span class='fa-thin fa-fw fa-eye-slash' aria-label='Hidden by inheritance'></span>" :
							$node.visibility = 3 ? "<span class='fa-thin fa-fw fa-eye' aria-label='Visible by inheritance'></span>" : "";
						$badges := $lock & $section & $visibility;
						{
							"icon": ($badges ? "<span style='float:right'>" & $badges & "</span>" : "") &
								"<span class='fa-light fa-fw fa-" & ($icon ? $icon : "rectangle") & "' aria-hidden='true'></span>",
							"url": "/stws/edit/edit-" & ($node.type in ["Portal", "Area", "Page"] ? $lowercase($node.type) : "content"),
							"uuid": $node.uuid,
							"name": $node.name.en,
							"type": $node.type,
							"children": $node.children ? [$map($node.children, $tree)] : []
						}
					)};
					$tree($))]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[ft(' ')apf\a('data-stw-editor data-uuid="@@uuid" onclick="event.preventDefault();_stwSendEditorRequest('@@url','@@uuid' )"')]]></text>
					</layout>
				</content>
				<content uuid="c6TC0s1xSa5SWiCO4QcQf7T" origin="a6T6S55WbZjerGVamxGi8kA" type="tree">
					<name>
						<text xml:lang="en" slug="explorer"><![CDATA[Explorer]]></text>
					</name>
					<query connector="node"><![CDATA[
						const fs = require("node:fs");
						const path = require("node:path");
						const escape = value => String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;")
							.replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#39;");
						const imageExtensions = new Set([".avif", ".bmp", ".gif", ".ico", ".jpeg", ".jpg", ".png", ".svg", ".tif", ".tiff", ".webp"]);
						const textExtensions = new Set([".acn", ".c", ".cc", ".config", ".cpp", ".css", ".csv", ".cjs", ".env",
							".go", ".h", ".hpp", ".htm", ".html", ".ini", ".java", ".js", ".json", ".log", ".md", ".mjs",
							".php", ".ps1", ".py", ".rb", ".rs", ".scss", ".sh", ".sql", ".tex", ".toml", ".ts", ".tsx",
							".txt", ".wbol", ".xml", ".yaml", ".yml"]);
						const tree = (name, location, directory) => {
							let label = "<span>" + escape(name) + "</span>";
							if (!directory) {
								const extension = path.extname(name).toLowerCase();
								const kind = imageExtensions.has(extension) ? "image" :
									textExtensions.has(extension) ? "text" : extension === ".pdf" ? "pdf" : "other";
								const file = path.relative(path.resolve("./public"), path.resolve(location)).split(path.sep).join("/");
								const onclick = "(function(node){const tabs=document.getElementById('c7StudioMainTabs000001');" +
									"const bar=tabs?.querySelector('dl > div');if(!bar)return;const file=node.dataset.stwFile;" +
									"let tab=[...bar.querySelectorAll('dt[data-ref]')].find(item=>item.dataset.stwFile===file);" +
									"if(!tab){tab=document.createElement('dt');tab.dataset.ref='c7StudioFileView000001';" +
									"tab.dataset.href='c7StudioFileView000001?file='+encodeURIComponent(file);" +
									"tab.dataset.stwFile=file;tab.dataset.stwKind=node.dataset.stwKind;tab.textContent=node.textContent;" +
									"const close=document.createElement('i');close.className='fa-light fa-xmark';" +
									"tab.append(' ',close);bar.append(tab);}if(!tab.classList.contains('stwSelected'))tab.click();})(this)";
								label = "<span data-stw-file=\"" + escape(file) + "\" data-stw-kind=\"" + kind +
									"\" onclick=\"" + escape(onclick) + "\">" + escape(name) + "</span>";
							}
							return {
								label,
								children: directory ? fs.readdirSync(location, { withFileTypes: true })
									.sort((a, b) => a.name.localeCompare(b.name))
									.map(entry => tree(entry.name, path.join(location, entry.name), entry.isDirectory())) : []
							};
						};
						console.log(JSON.stringify(tree("public", "./public", true)));
					]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('header="&emsp;EXPLORER"')f]]></text>
					</layout>
				</content>
				<content uuid="c7K3dAiAsstAsk000000002" origin="a6T6S55WbZjerGVamxGi8kA" type="form"
					class="stwForm stwCompact">
					<name>
						<text xml:lang="en" slug="assistant-ask"><![CDATA[Ask]]></text>
					</name>
					<query connector="assistant" parameters="/state"><![CDATA[$]]></query>
					<layout>
						<text xml:lang="en"><![CDATA[\s('header="Local model: the element and chat are sent to the local assistant."')
l('Element UUID')e(';uuid;@@uuid')\n
l('Share this context with the local model')e('checkbox;consent;yes')\n
l('Message')m(';message')\n
b('.;stwsubmit;assistant;/chat')t('Send')b('.;stwsubmit;assistant;/apply')t('Apply proposal')]]></text>
					</layout>
				</content>
				<content uuid="c7K3dAiAsstHist00000003" origin="a6T6S55WbZjerGVamxGi8kA" type="table">
