					<layout>
						<text xml:lang="en"><![CDATA[\s('caption="Offices" key="officeId"')l('City')hel('Tel.')e\a('type="tel"')b(';stw;delete')t('-')b(';stw;insert')t('+')]]></text>
					</layout>
					<visibility>
						<role id="guests" visibility="true" />
					</visibility>
				</content>
				<content uuid="c5B17joaUJGDnbYu9ft7xlH" origin="wGGpiW7IjjrFqapqVuZopW" type="calendar"
