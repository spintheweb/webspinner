				<content uuid="c3YCLoAbUczj9NNvlOFO081" origin="wGGpiW7IjjrFqapqVuZopW" type="table"
					sequence="1">
					<name>
						<text xml:lang="en" slug="files"><![CDATA[Files]]></text>
					</name>
					<query datasource="bash"><![CDATA[ls -l ./public | awk '
BEGIN {
    print "["
}
NR>1 {
    printf "%s{\"permissions\":\"%s\",\"links\":\"%s\",\"owner\":\"%s\",\"group\":\"%s\",\"size\":%s,\"month\":\"%s\",\"day\":\"%s\",\"time\":\"%s\",\"name\":\"%s\"}",
        (NR>2?",":""), $1, $2, $3, $4, $5, $6, $7, $8, $9
}
END {
    print "]"
}'
]]></query>
				</content>
				<content uuid="c3YCLoAbUczjbaXTHruz8Yx" origin="wGGpiW7IjjrFqapqVuZopW" type="list" sequence="5">
					<name>
