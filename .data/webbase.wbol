			<visibility><role id="quality" visibility="true" /><role id="developer" visibility="true" /></visibility>
			<children>
				<page uuid="pSrTvZ3Nr3PhWKdFcJScsg" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="overview"><![CDATA[Quality overview]]></text></name>
					<children>
						<content uuid="c7LE2bamKa8svvapyll2yUa" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="quality-workspace"><![CDATA[Quality workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Quality workspace</h1><p>Make inspection, traceability, and improvement visible across the bicycle's journey from component to rider.</p>
<p><a href="/quality/inspection">Inspection and learning</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p6o1YFSrm1LzJf27mLxAoeg" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="inspection"><![CDATA[Inspection and learning]]></text></name>
					<children>
						<content uuid="c58hvoZYb8HPWZZfw7OjKwU" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="quality-process"><![CDATA[Quality process]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Inspection and learning</h1><p>Capture inspection outcomes and share recurring findings with engineering, procurement, production, and service.</p>
<p>Inspection records can be connected to this workspace when available.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a3PjuRiufRmRP1D4NG03B36" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="p6K3bDhzrk1RbZqk8MtTsNJ">
