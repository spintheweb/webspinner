			<visibility><role id="service" visibility="true" /><role id="developer" visibility="true" /></visibility>
			<children>
				<page uuid="p6K3bDhzrk1RbZqk8MtTsNJ" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="overview"><![CDATA[Service overview]]></text></name>
					<children>
						<content uuid="cgeI9ahhFjHJsZRijrNwI1" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="service-workspace"><![CDATA[Service workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Service workspace</h1><p>Help riders enjoy their bicycles for longer, and bring field feedback back to the people who design and build them.</p>
<p><a href="/service/repairs">Repair coordination</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p5qMbXA1nAVR2EPcs4DDeUz" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="repairs"><![CDATA[Repair coordination]]></text></name>
					<children>
						<content uuid="c6yg734ZVlIVcVugE0r1418" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="repair-journey"><![CDATA[Repair journey]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Repair coordination</h1><p>Coordinate the rider's request, inspection, parts, and return of the bicycle with qualified service providers.</p>
<p>This is a workflow overview, not a live repair queue.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a1zRo36ELHxTtxuixOybL7l" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="p1wyIre3Y8EYMnSSImKajim">
			<name><text xml:lang="en" slug="finance"><![CDATA[Finance]]></text></name>
			<visibility><role id="finance" visibility="true" /><role id="developer" visibility="true" /></visibility>
			<children>
				<page uuid="p1wyIre3Y8EYMnSSImKajim" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="overview"><![CDATA[Finance overview]]></text></name>
					<children>
						<content uuid="c3fp1loa9VRb8FZITtpbeuq" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="finance-workspace"><![CDATA[Finance workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Finance workspace</h1><p>Support responsible decisions across the business with a shared view of planning and financial processes.</p>
<p><a href="/finance/planning">Planning and reporting</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p6yT7rUscX9EEyLrXBU3DXY" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="planning"><![CDATA[Planning and reporting]]></text></name>
					<children>
						<content uuid="c6Xjmo8QJW6VQfpjCUMBhxa" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="planning-process"><![CDATA[Planning process]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Planning and reporting</h1><p>Coordinate budgets, forecasts, and reporting with the teams responsible for sales, purchasing, and production.</p>
<p>Financial records are not connected to this example workspace.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

