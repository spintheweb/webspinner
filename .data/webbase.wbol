		<page uuid="pGGpiXMKLBB9JzXmwCV1IY" origin="wGGpiW7IjjrFqapqVuZopW">
			<name>
				<text xml:lang="en" slug="home"><![CDATA[Home]]></text>
			</name>
			<children>
				<content uuid="c1wUcP37YPMX2JLe7WZchID" origin="wGGpiW7IjjrFqapqVuZopW" type="text"
					section="main" sequence="1">
					<name><text xml:lang="en" slug="welcome"><![CDATA[Welcome]]></text></name>
					<layout>
						<text xml:lang="en"><![CDATA[
<h1>Make every journey a little more joyful.</h1>
<p>At Northstar Cycles, we imagine bicycles that feel at home on the morning commute, the long way home, and the road beyond.</p>
<p>Explore our <a href="/bicycles/range">bicycle range</a>, discover <a href="/bicycles/craft">how we build</a>, or find <a href="/support/welcome">rider support</a>.</p>
						]]></text>
					</layout>
				</content>
				<content uuid="cGn4RZbeJxmRPcuHcQjxf1" origin="wGGpiW7IjjrFqapqVuZopW" type="text"
					section="main" sequence="2">
					<name><text xml:lang="en" slug="our-approach"><![CDATA[Our approach]]></text></name>
					<layout>
						<text xml:lang="en"><![CDATA[
<h2>Built for the ride ahead</h2>
<p>We bring design, manufacturing, and care together around a simple idea: a bicycle should invite its rider to keep exploring.</p>
<p>Our teams have their own workspaces in the navigation once they sign in.</p>
						]]></text>
					</layout>
				</content>
			</children>
		</page>

		<area uuid="a4WlL07c1X206fDR4jVCGm0" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="p7pMcIkWyTZSgIenHyDI22u">
			<name><text xml:lang="en" slug="bicycles"><![CDATA[Bicycles]]></text></name>
			<visibility>
				<role id="guest" visibility="true" />
				<role id="user" visibility="true" />
				<role id="developer" visibility="true" />
				<role id="seo" visibility="true" />
			</visibility>
			<children>
				<page uuid="p7pMcIkWyTZSgIenHyDI22u" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="range"><![CDATA[Our bicycles]]></text></name>
					<children>
						<content uuid="c1kDfy0mDH0EmAKm16sDjPp" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="range-introduction"><![CDATA[Find your ride]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Find your ride</h1>
<h2>City</h2><p>A practical companion for errands, commutes, and discovering your neighborhood.</p>
<h2>Trail</h2><p>A versatile bicycle for unpaved paths and weekends that start where the pavement ends.</p>
<h2>Touring</h2><p>A steady companion for longer journeys, with room for the things you need along the way.</p>
<p>Discover our <a href="/bicycles/craft">approach to craft</a> and <a href="/bicycles/sustainability">design for longevity</a>.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p3b8ARmwgLRHao7HbDUU2sO" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="craft"><![CDATA[Our craft]]></text></name>
					<children>
						<content uuid="cskpfGnQuSiS1v9zctaHq6" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="craft-story"><![CDATA[From idea to ride]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>From idea to ride</h1>
<p>A bicycle begins with the needs of its rider. Our designers, builders, and service team work together to turn those needs into a useful, maintainable machine.</p>
<p><a href="/bicycles/range">Explore the range</a> or learn about <a href="/bicycles/sustainability">designing for longevity</a>.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p7wiIl4GxnEoqTEXScS523K" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="sustainability"><![CDATA[Design for longevity]]></text></name>
					<children>
						<content uuid="cxiWIqE7vaYR6y7I7Rib8c" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="longevity"><![CDATA[Keep riding]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Made to keep riding</h1>
<p>Our design goal is to make bicycles easy to care for, with serviceable components and clear guidance for their owners.</p>
<p>Visit <a href="/support/care">bicycle care</a> for a starting point.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a2uflK3oAqSUsnP16JeKZQW" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="p1szvbl5yL1uy30ayF29IL6">
			<name><text xml:lang="en" slug="support"><![CDATA[Rider support]]></text></name>
			<visibility>
				<role id="guest" visibility="true" />
				<role id="user" visibility="true" />
				<role id="developer" visibility="true" />
				<role id="seo" visibility="true" />
			</visibility>
			<children>
				<page uuid="p1szvbl5yL1uy30ayF29IL6" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="welcome"><![CDATA[Rider support]]></text></name>
					<children>
						<content uuid="c1dedkg4IHdWJwY8kV5xjfG" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="support-introduction"><![CDATA[Here for the journey]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Here for the journey</h1>
<p>Find practical guidance for looking after your bicycle and understanding the support available to riders.</p>
<p><a href="/support/care">Bicycle care</a> &middot; <a href="/support/warranty">Warranty and service</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p1StPE4cgmVIsGdQXy5lcMz" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="care"><![CDATA[Bicycle care]]></text></name>
					<children>
						<content uuid="c32OIjsJxrVXBRNZubgVpXc" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="care-guide"><![CDATA[Care guide]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Care for your bicycle</h1>
<p>Follow the instructions supplied with your bicycle and arrange regular servicing with a qualified bicycle mechanic.</p>
<p>Before riding, check that the bicycle is in good condition. If anything seems unsafe or uncertain, have it inspected before use.</p>
<p>See <a href="/support/warranty">warranty and service</a> for further guidance.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="pwmPZOEkwDnvCOqtgEPWnW" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="warranty"><![CDATA[Warranty and service]]></text></name>
					<children>
						<content uuid="c1LOWJ5AkV0i6o1mWaGCWmr" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="warranty-guidance"><![CDATA[Getting assistance]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Warranty and service</h1>
<p>Keep your proof of purchase and bicycle details handy when requesting assistance. Warranty terms and service arrangements depend on the bicycle and where it was purchased.</p>
<p>Consult the documentation supplied with your bicycle or the retailer for the applicable terms.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a7KKERNwUU9pADVAEFTnSwz" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="p2KSHSP5YcPpkEDVDfqC4G1">
			<name><text xml:lang="en" slug="sales"><![CDATA[Sales]]></text></name>
			<visibility><role id="sales" visibility="true" /><role id="developer" visibility="true" /></visibility>
			<children>
				<page uuid="p2KSHSP5YcPpkEDVDfqC4G1" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="overview"><![CDATA[Sales overview]]></text></name>
					<children>
						<content uuid="c2H2r7mdNeCiSyWCefIkjMt" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="sales-workspace"><![CDATA[Sales workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Sales workspace</h1><p>Connect riders and retailers with the right bicycles, and coordinate commitments with the teams that build and support them.</p>
<p><a href="/sales/orders">Orders and handoffs</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p4kEZMDRaQgtwgo5RWSF5lT" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="orders"><![CDATA[Orders and handoffs]]></text></name>
					<children>
						<content uuid="c4AS5QR8kqPRegoVyTO7BwN" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="order-journey"><![CDATA[Order journey]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Orders and handoffs</h1><p>From a rider's inquiry to delivery, record the agreed bicycle, configuration, delivery expectations, and the next responsible team.</p>
<p>This workspace is a starting point for connecting an order system; it does not display live orders.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a3jT83RjBE232acdcpDWu6B" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="pjPUQRJvgxFzvshXtQjLBR">
			<name><text xml:lang="en" slug="engineering"><![CDATA[Engineering]]></text></name>
			<visibility><role id="engineering" visibility="true" /><role id="developer" visibility="true" /></visibility>
			<children>
				<page uuid="pjPUQRJvgxFzvshXtQjLBR" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="overview"><![CDATA[Engineering overview]]></text></name>
					<children>
						<content uuid="c57Ci8n8TIkJNB7ASpHUzIW" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="engineering-workspace"><![CDATA[Engineering workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Engineering workspace</h1><p>Shape the next generation of bicycles, from rider needs and frame geometry to maintainable components.</p>
<p><a href="/engineering/designs">Designs and change decisions</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="plr6y7YMt2PbTka1qSg6Hn" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="designs"><![CDATA[Designs and changes]]></text></name>
					<children>
						<content uuid="c3g5G563ZoPreF6U0GE47A8" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="design-brief"><![CDATA[Design brief]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Designs and change decisions</h1><p>Bring design briefs, revisions, and engineering decisions together before sharing approved changes with production and service.</p>
<p>Connect this page to the organization's design and product records when they are available.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a6l3mGYPpHoDUm5wxSO77Jm" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="p5Lp1U9cQtWaWOz7lyK8niG">
			<name><text xml:lang="en" slug="production"><![CDATA[Production]]></text></name>
			<visibility><role id="production" visibility="true" /><role id="developer" visibility="true" /></visibility>
			<children>
				<page uuid="p5Lp1U9cQtWaWOz7lyK8niG" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="overview"><![CDATA[Production overview]]></text></name>
					<children>
						<content uuid="c5x8GW9WUqc9hm3jqWd5V9z" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="production-workspace"><![CDATA[Production workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Production workspace</h1><p>Coordinate materials, assembly, and the handoff to quality so each bicycle follows an understood build process.</p>
<p><a href="/production/assembly">Assembly journey</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p7dEZo77LN3KSLCDZpxpdqJ" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="assembly"><![CDATA[Assembly journey]]></text></name>
					<children>
						<content uuid="c7dqrGt5MF6LtSowLm41KzB" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="assembly-overview"><![CDATA[Assembly overview]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Assembly journey</h1><p>Follow the bicycle from prepared components through assembly, inspection, and readiness for delivery.</p>
<p>This page describes the workflow; it is not connected to a production schedule.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a3pIFbylNxOJJtOVHl86peI" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="p5dMOFjOKiFNvoOFXx0uLtU">
			<name><text xml:lang="en" slug="procurement"><![CDATA[Procurement]]></text></name>
			<visibility><role id="procurement" visibility="true" /><role id="developer" visibility="true" /></visibility>
			<children>
				<page uuid="p5dMOFjOKiFNvoOFXx0uLtU" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="overview"><![CDATA[Procurement overview]]></text></name>
					<children>
						<content uuid="c7bcrs7T5H0s2h297jBImNF" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="procurement-workspace"><![CDATA[Procurement workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Procurement workspace</h1><p>Bring together the materials and supplier relationships needed to support reliable bicycle production.</p>
<p><a href="/procurement/suppliers">Supplier collaboration</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p5dpWpdfTQizylaDsoFPOcE" origin="wGGpiW7IjjrFqapqVuZopW">
					<name><text xml:lang="en" slug="suppliers"><![CDATA[Supplier collaboration]]></text></name>
					<children>
						<content uuid="c59sUComLSKBtiUFQ7GCOoX" origin="wGGpiW7IjjrFqapqVuZopW" type="text" section="main" sequence="1">
							<name><text xml:lang="en" slug="supplier-handoffs"><![CDATA[Supplier handoffs]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>Supplier collaboration</h1><p>Coordinate specifications, purchasing decisions, and delivery expectations with suppliers and the production team.</p>
<p>Supplier records and purchasing data can be connected here when available.</p>
							]]></text></layout>
						</content>
					</children>
				</page>
			</children>
		</area>

		<area uuid="a6jnetwAOXcuySpMyGfCCsI" origin="wGGpiW7IjjrFqapqVuZopW" mainpage="pSrTvZ3Nr3PhWKdFcJScsg">
