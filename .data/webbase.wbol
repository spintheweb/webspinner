				<content uuid="c4sHhypzNzBJ7LpOv3ROBvX" origin="wGGpiW7IjjrFqapqVuZopW" type="text"
					section="main" sequence="9">
					<name>
						<text xml:lang="en" slug="explain"><![CDATA[Explain]]></text>
					</name>
					<layout>
						<text xml:lang="en"><![CDATA[<h2>Welcome to the Spin the Web Labs</h2><h3>What is WBOL (Webbase Ontology Language)?</h3><spn>While <strong>HTML (HyperText Markup Language)</strong> describes the structure and content of a single web page and is interpreted and rendered by <i>client-side browsers</i>, <strong>WBOL (Webbase Ontology Language)</strong> describes the architecture, composition and function of an entire web portal and is interpreted and rendered by <i>server-side webspinners</i>.</span>]]></text>
					</layout>
					<visibility>
						<role id="guests" visibility="true" />
					</visibility>
				</content>
				<content uuid="c5pFgYiS4cfdHZyTCNV3Wdi" origin="wGGpiW7IjjrFqapqVuZopW" type="table"
