							<name><text xml:lang="en" slug="people-workspace"><![CDATA[People workspace]]></text></name>
							<layout><text xml:lang="en"><![CDATA[
<h1>People workspace</h1><p>Support the people behind every bicycle, from joining the team to learning, collaboration, and workplace wellbeing.</p>
<p><a href="/people/safety">Learning and safety</a></p>
							]]></text></layout>
						</content>
					</children>
				</page>
				<page uuid="p4FedGcJk4rKDjq6iTdlr5b" origin="wGGpiW7IjjrFqapqVuZopW">
