{
	"name": "spintheweb",
	"version": "0.3.5",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"start": "node dist/stwSpinner.js",
		"dev": "npm run build && node --watch dist/stwSpinner.js",
		"build": "tsc -p tsconfig.json --noCheck",
		"build:client": "node tasks/minify.ts",
		"dev:tasks": "node tasks/dev.ts",
		"release": "npm run build && node tasks/release.ts",
		"test": "node --test"
	},
	"dependencies": {
		"@xmldom/xmldom": "^0.8.11",
		"jsonata": "^2.1.0",
		"mongodb": "^6.15.0",
		"mssql": "^11.0.1",
		"mysql2": "^3.14.0",
		"pg": "^8.14.1",
		"ws": "^8.18.1"
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"@types/mssql": "^9.1.7",
		"@types/node": "^22.13.10",
		"@types/pg": "^8.11.13",
		"@types/ws": "^8.18.1",
		"typescript": "^5.8.2"
	}
}
