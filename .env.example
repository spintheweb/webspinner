# Webspinner configuration example
# Server Configuration
HOST=localhost
PORT=8080

# TLS/SSL Configuration (optional for HTTPS)
CERTFILE=
KEYFILE=

# Session Configuration
SESSION_TIMEOUT=24
MAX_USERS=0
MAX_UPLOADSIZE=5

# Site Configuration
PORTAL_ROOT="./public"
WEBBASE="./.data/webbase.wbol"
COMMON_WEBBASELET="./webbaselets/stwCommon.wbol"
STUDIO_WEBBASELET="./webbaselets/stwStudio.wbol"

# Security Configuration
CONNECTORS="./.data/connectors.json"
USERS="./.data/users.json"

# Security Modes
DEPLOYED=true
ALLOW_DEV=true
ALLOW_ROOT=false
ALLOW_AI=false

# Optional local Studio assistant (same token as the assistant service)
STW_ASSISTANT_TOKEN=
STW_ASSISTANT_PORT=11435
