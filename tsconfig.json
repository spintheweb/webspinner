{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": "dist",
		"sourceMap": true,
		"inlineSources": true,
		"strict": true,
		"skipLibCheck": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["node"],
		"noEmitOnError": true
	},
	"include": [
		"stwSpinner.ts",
		"stwComponents/**/*.ts",
		"stwContents/**/*.ts",
		"stwElements/**/*.ts"
	],
	"exclude": ["tests", "tasks", "node_modules", "dist"]
}
